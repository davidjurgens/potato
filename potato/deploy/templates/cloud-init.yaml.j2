#cloud-config
# First-boot provisioning for a Potato VM (DigitalOcean, Lightsail, EC2,
# Hetzner, Vultr, Linode, OpenStack).
#
# This only prepares the machine. The bundle arrives over SFTP afterwards,
# because user_data is capped (16 KB on Lightsail, 64 KB on DigitalOcean) and a
# project with data files passes that immediately.
#
# Keep this idempotent and quiet on failure paths: everything here runs before
# anyone can watch it, and the only forensics are /var/log/cloud-init-output.log.

{% if ssh_authorized_key and deploy_user %}
# A login of our own, for images whose default user varies by cloud (OpenStack
# images ship as ubuntu, exouser, cloud-user...). Passwordless sudo, key only.
users:
  - default
  - name: {{ deploy_user }}
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - {{ ssh_authorized_key }}

{% elif ssh_authorized_key %}
# The per-deployment deploy key, for the image's default login (root, ubuntu).
# Delivered here rather than through each provider's key-pair API, which differ
# in which key types they accept.
ssh_authorized_keys:
  - {{ ssh_authorized_key }}

{% endif %}
# Key-only SSH. Some providers set a root password at creation (Linode requires
# one; Hetzner emails one when no key is registered); it must not open a login.
ssh_pwauth: false

package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl
  - sqlite3
  - ufw

write_files:
  # The image is pulled and run by a systemd unit rather than by cloud-init, so
  # a reboot brings the task back without anyone logging in.
  - path: /etc/systemd/system/potato.service
    permissions: '0644'
    content: |
{{ potato_service | indent(6, true) }}

  - path: /etc/caddy/Caddyfile
    permissions: '0644'
    content: |
{{ caddyfile | indent(6, true) }}

  - path: /etc/systemd/system/caddy-potato.service
    permissions: '0644'
    content: |
{{ caddy_service | indent(6, true) }}

runcmd:
  # Docker from the convenience script: the distro package lags far enough
  # behind that compose plugin availability varies by image.
  - [ sh, -c, "command -v docker >/dev/null 2>&1 || (curl -fsSL https://get.docker.com | sh)" ]
  - [ systemctl, enable, --now, docker ]

  - [ mkdir, -p, "{{ data_dir }}" ]
  # An attached volume is prepared over SSH after the provider reports it
  # attached (see vm_base.prepare_volume_script). Doing it here raced the
  # attach: first boot often ran before the disk existed, the mount failed
  # quietly under `nofail`, and the task was written to the root disk.
  - [ mkdir, -p, "{{ app_dir }}" ]

  # Both directories are bind-mounted into a container that runs as uid 1000.
  # Created by root they are unwritable by the server, which then dies during
  # boot on its first log write. A volume mounted later replaces the directory,
  # so the volume script chowns again after its mount.
  - [ chown, -R, "1000:1000", "{{ app_dir }}" ]
  - [ chown, -R, "1000:1000", "{{ data_dir }}" ]

  # The firewall is belt-and-braces: the provider's own firewall already blocks
  # everything else, but a cloud firewall deleted by hand in the console should
  # not silently expose port {{ app_port }}.
  - [ ufw, allow, "22/tcp" ]
  - [ ufw, allow, "80/tcp" ]
  - [ ufw, allow, "443/tcp" ]
  - [ ufw, --force, enable ]

  - [ sh, -c, "docker pull {{ image }}" ]
  - [ sh, -c, "docker pull {{ caddy_image }}" ]
  - [ systemctl, daemon-reload ]
  - [ systemctl, enable, potato.service ]
  - [ systemctl, enable, caddy-potato.service ]

final_message: "potato host ready after $UPTIME seconds"
